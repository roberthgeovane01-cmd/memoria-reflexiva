# ---------------------------------------------------------------------------
# MEMÓRIA REFLEXIVA — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA faça commit do `.env.local`.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: usada SOMENTE no servidor (jobs, rotas de API privadas).
# Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedores de IA ------------------------------------------------------
# Deixe em branco para rodar em MODO DEMONSTRAÇÃO (providers mock determinísticos).
OPENAI_API_KEY=

# Provider de cada capacidade: "openai" | "elevenlabs" | "mock"
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
TRANSCRIPTION_PROVIDER=openai
TTS_PROVIDER=elevenlabs
RERANKING_PROVIDER=heuristic
OCR_PROVIDER=none

# --- Modelos (configuráveis) ----------------------------------------------
ANALYSIS_MODEL=gpt-5-mini
WRITER_MODEL=gpt-5
TRANSCRIPTION_MODEL=whisper-1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Text to Speech --------------------------------------------------------
TTS_API_KEY=
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_MODEL=eleven_multilingual_v2

# --- Limites operacionais (MVP, ajustáveis) --------------------------------
MAX_DOCUMENT_BYTES=52428800
MAX_AUDIO_BYTES=104857600
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

# --- Aplicação -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Memória Reflexiva
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo compartilhado para acionar o worker de jobs via HTTP (cron da Vercel).
JOB_RUNNER_SECRET=
